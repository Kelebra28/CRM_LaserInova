generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                 @id @default(uuid())
  name                   String
  email                  String                 @unique
  passwordHash           String
  role                   String                 @default("SELLER")
  active                 Boolean                @default(true)
  emailPasswordEncrypted String?
  emailIncomingServer    String?                @default("imap.hostinger.com")
  emailOutgoingServer    String?                @default("smtp.hostinger.com")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  quotes                 Quote[]
  createdTransactions    FinancialTransaction[] @relation("TransactionCreatedBy")
  deletedTransactions    FinancialTransaction[] @relation("TransactionDeletedBy")
  createdTasks           Task[]                 @relation("TaskCreatedBy")
  taskAssignments        TaskAssignee[]
  paymentRequests        PaymentRequest[]       @relation("PaymentRequestCreatedBy")
  providers              Provider[]
  emails                 Email[]
  receipts               Receipt[]
}

model Client {
  id                    String                 @id @default(uuid())
  name                  String
  company               String?
  email                 String?
  phone                 String?
  rfc                   String?
  address               String?
  notes                 String?                @db.Text
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  quotes                Quote[]
  financialTransactions FinancialTransaction[]
  emails                Email[]
  receipts              Receipt[]
  paymentRequests       PaymentRequest[]
  whatsappContacts      WhatsAppContact[]
}

model MaterialCategory {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  active    Boolean    @default(true)
  materials Material[]
}

model Material {
  id              String           @id @default(uuid())
  categoryId      String
  name            String
  brand           String?
  family          String?
  color           String?
  thickness       Float?
  length          Float?
  width           Float?
  sheetPrice      Float?
  guardPercentage Float?
  productionPrice Float?
  pricePerCm2     Float?
  location        String?
  notes           String?          @db.Text
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  category        MaterialCategory @relation(fields: [categoryId], references: [id])
  quoteConcepts   QuoteConcept[]

  @@index([categoryId], map: "Material_categoryId_fkey")
}

model ProductCategory {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  active   Boolean   @default(true)
  products Product[]
}

model Product {
  id            String          @id @default(uuid())
  categoryId    String
  name          String
  model         String?
  brand         String?
  color         String?
  stockQuantity Int             @default(0)
  unitCost      Float           @default(0)
  unitPrice     Float           @default(0)
  image         String?         @db.Text
  notes         String?         @db.Text
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  category      ProductCategory @relation(fields: [categoryId], references: [id])
  quoteConcepts QuoteConcept[]

  @@index([categoryId], map: "Product_categoryId_fkey")
}

model CostConfiguration {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  value     Float
  unit      String?
  adminOnly Boolean  @default(true)
  type      String?
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Quote {
  id                    String                 @id @default(uuid())
  folio                 String                 @unique
  clientId              String?
  prospectName          String?
  userId                String
  project               String
  description           String?                @db.Text
  images                Json?
  status                String                 @default("DRAFT")
  paymentStatus         String                 @default("PENDING")
  taxable               Boolean                @default(true)
  subtotal              Float                  @default(0)
  tax                   Float                  @default(0)
  total                 Float                  @default(0)
  realCostTotal         Float                  @default(0)
  estimatedUtility      Float                  @default(0)
  realAmountCollected   Float?                 @default(0)
  realUtilityTotal      Float?                 @default(0)
  isDone                Boolean                @default(false)
  stockDeducted         Boolean                @default(false)
  sentDate              DateTime?
  closeDate             DateTime?
  deliveryTime          String?
  validityDays          Int?
  paymentConditions     String?                @db.Text
  internalNotes         String?                @db.Text
  visibleConsiderations String?                @db.Text
  versionGroupId        String?
  versionName           String?
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  snapshot              CalculationSnapshot?
  emailLogs             EmailLog[]
  client                Client?                @relation(fields: [clientId], references: [id])
  user                  User                   @relation(fields: [userId], references: [id])
  concepts              QuoteConcept[]
  financialTransactions FinancialTransaction[]
  surveyResponse        SurveyResponse?
  paymentRequests       PaymentRequest[]

  @@index([clientId], map: "Quote_clientId_fkey")
  @@index([userId], map: "Quote_userId_fkey")
}

model QuoteConcept {
  id                     String    @id @default(uuid())
  quoteId                String
  conceptType            String
  description            String    @db.Text
  quantity               Int       @default(1)
  materialId             String?
  productId              String?
  clientProvidesMaterial Boolean   @default(false)
  width                  Float?
  height                 Float?
  thickness              Float?
  cutTime                Float?
  engraveTime            Float?
  machineType            String?
  details                String?   @db.Text
  serviceDays            Float?    @default(0)
  serviceHours           Float?    @default(0)
  operatorCost           Float?    @default(0)
  transportCost          Float?    @default(0)
  installCost            Float?    @default(0)
  laserUseCost           Float?    @default(0)
  consumablesCost        Float?    @default(0)
  viaticsCost            Float?    @default(0)
  materialCost           Float?    @default(0)
  productionCost         Float?    @default(0)
  realCost               Float?    @default(0)
  margin                 Float?
  suggestedPrice         Float?    @default(0)
  finalUnitPrice         Float     @default(0)
  totalAmount            Float     @default(0)
  order                  Int       @default(0)
  material               Material? @relation(fields: [materialId], references: [id])
  product                Product?  @relation(fields: [productId], references: [id])
  quote                  Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([materialId], map: "QuoteConcept_materialId_fkey")
  @@index([productId], map: "QuoteConcept_productId_fkey")
  @@index([quoteId], map: "QuoteConcept_quoteId_fkey")
}

model CalculationSnapshot {
  id           String   @id @default(uuid())
  quoteId      String   @unique
  globalValues String   @db.LongText
  factors      String   @db.LongText
  intermediate String?  @db.LongText
  createdAt    DateTime @default(now())
  quote        Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
}

model EmailLog {
  id           String   @id @default(uuid())
  quoteId      String
  sentById     String
  sentTo       String
  subject      String
  body         String
  status       String   @default("PENDING")
  smtpResponse String?
  sentDate     DateTime @default(now())
  quote        Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId], map: "EmailLog_quoteId_fkey")
}

// ============================================================
// MÓDULO FINANCIERO — Movimientos contables operativos
// ============================================================

model FinancialTransaction {
  id String @id @default(uuid())

  // Clasificación principal
  // GASTO_OPERATIVO | GASTO_PROYECTO | INGRESO | ANTICIPO | LIQUIDACION | AJUSTE
  type String

  // Categoría para agrupar y filtrar
  category String

  // Montos
  amount    Float
  taxAmount Float @default(0) // IVA separado si aplica

  // Descripción y contexto
  description   String
  notes         String?  @db.Text
  date          DateTime
  paymentMethod String? // efectivo | transferencia | tarjeta | deposito | otro
  provider      String? // Proveedor u origen del movimiento

  // Relaciones opcionales a proyecto o cliente
  quoteId  String?
  clientId String?

  // Auditoría de creación / edición
  createdById String?
  updatedById String?

  // Soft delete
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  // Estado: ACTIVO | ANULADO
  status String @default("ACTIVO")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  quote     Quote?  @relation(fields: [quoteId], references: [id])
  client    Client? @relation(fields: [clientId], references: [id])
  createdBy User?   @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  deletedBy User?   @relation("TransactionDeletedBy", fields: [deletedById], references: [id])

  @@index([quoteId])
  @@index([clientId])
  @@index([createdById])
  @@index([deletedById])
  @@index([type])
  @@index([date])
  @@index([isDeleted])
}

// ============================================================
// MÓDULO DE TAREAS — Kanban interno del equipo
// ============================================================

model Task {
  id            String         @id @default(uuid())
  title         String
  description   String?        @db.Text
  status        String         @default("PENDING") // BACKLOG | PENDING | IN_PROGRESS | BLOCKED | DONE
  priority      String         @default("NORMAL") // LOW | NORMAL | HIGH
  points        Int            @default(0) // 1 punto = 1 hora
  progress      Int            @default(0) // 0-100 — activo solo en IN_PROGRESS y BLOCKED
  blockerReason String?        @db.Text // Obligatorio cuando status = BLOCKED
  dueDate       DateTime?
  order         Int            @default(0)
  createdById   String?
  createdBy     User?          @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignees     TaskAssignee[]
  subtasks      SubTask[]
  tags          TaskTag[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([createdById])
}

model TaskTag {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("gray")
  tasks     Task[]
  createdAt DateTime @default(now())
}

model TaskAssignee {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model SubTask {
  id        String   @id @default(uuid())
  taskId    String
  title     String
  done      Boolean  @default(false)
  order     Int      @default(0)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model MachineProcess {
  id               String   @id @default(uuid())
  machineName      String
  material         String
  engravePower     Float?
  engraveSpeed     Float?
  engraveFrequency Float?
  waveType         String?
  cutPower         Float?
  cutSpeed         Float?
  notes            String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Email {
  id          String       @id @default(uuid())
  messageId   String       @db.Text
  uid         Int?
  threadId    String?
  subject     String       @db.Text
  from        String       @db.Text
  to          String       @db.Text
  cc          String?      @db.Text
  bcc         String?      @db.Text
  snippet     String?      @db.Text
  isRead      Boolean      @default(false)
  isStarred   Boolean      @default(false)
  folder      String       @default("INBOX")
  receivedAt  DateTime
  clientId    String?
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  storagePath String?      
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([clientId])
  @@index([userId])
  @@index([folder])
  @@index([threadId])
  @@index([receivedAt])
  @@unique([userId, folder, uid])
}

model Attachment {
  id          String   @id @default(uuid())
  emailId     String
  filename    String   @db.Text
  mimeType    String
  size        Int
  contentId   String?
  storagePath String?
  email       Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([emailId])
}

model Provider {
  id                      String            @id @default(uuid())
  companyName             String
  address                 String?           @db.Text
  website                 String?
  portalUsername          String?
  portalPasswordEncrypted String?           @db.Text
  active                  Boolean           @default(true)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  userId                  String
  user                    User              @relation(fields: [userId], references: [id])
  contacts                ProviderContact[]

  @@index([userId])
}

model ProviderContact {
  id         String   @id @default(uuid())
  providerId String
  name       String
  phone      String?
  email      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

model ProjectRecipe {
  id             String              @id @default(uuid())
  name           String
  machineName    String
  rotaryDiameter Float?
  notes          String?             @db.Text
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  steps          ProjectRecipeStep[]
}

model ProjectRecipeStep {
  id               String        @id @default(uuid())
  recipeId         String
  name             String
  power            Float?
  speed            Float?
  frequency        Float?
  passesCount      Int?          @default(1)
  hatchLineSpacing Float?
  hatchAngle       Float?
  order            Int           @default(0)
  recipe           ProjectRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model Receipt {
  id            String   @id @default(uuid())
  folio         String   @unique
  clientId      String?
  prospectName  String?
  userId        String
  project       String
  description   String?  @db.Text
  concepts      Json?    // Array of concepts: [{ description, quantity, unitPrice, total }]
  total         Float    @default(0)
  advance       Float    @default(0) // Anticipo
  balance       Float    @default(0) // Restante pendiente
  paymentMethod String   @default("EFECTIVO") // EFECTIVO, TRANSFERENCIA, TARJETA, DEPOSITO
  notes         String?  @db.Text
  status        String   @default("PENDING") // PENDING (pendiente de liquidar), PAID (liquidado)
  quoteId       String?  // Reference to original quote if pulled from it
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  client        Client?  @relation(fields: [clientId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@index([userId])
}

model SurveyQuestion {
  id        String         @id @default(uuid())
  text      String         @db.Text
  order     Int            @default(0)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  answers   SurveyAnswer[]
}

model SurveyResponse {
  id           String         @id @default(uuid())
  quoteId      String         @unique
  averageScore Float          @default(0)
  feedbackText String?        @db.Text
  createdAt    DateTime       @default(now())
  quote        Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  answers      SurveyAnswer[]

  @@index([quoteId])
}

model SurveyAnswer {
  id         String         @id @default(uuid())
  responseId String
  questionId String
  score      Int            // 1 to 5
  response   SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question   SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([questionId])
}

model PaymentRequest {
  id              String   @id @default(uuid())
  amountRequested Float
  status          String   @default("PENDING") // PENDING, PAID, CANCELED
  notes           String?  @db.Text
  
  quoteId         String
  quote           Quote    @relation(fields: [quoteId], references: [id])
  
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id])
  
  createdById     String
  createdBy       User     @relation("PaymentRequestCreatedBy", fields: [createdById], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([quoteId])
  @@index([clientId])
  @@index([createdById])
}

model WhatsAppContact {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String?
  botMode   Boolean  @default(true) // Si está en true, la IA responde automáticamente
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  messages  WhatsAppMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model WhatsAppMessage {
  id         String   @id @default(uuid())
  contactId  String
  messageId  String   @unique // ID provisto por Meta
  direction  String   // 'INBOUND' o 'OUTBOUND'
  type       String   // 'TEXT', 'IMAGE', 'AUDIO', 'DOCUMENT'
  content    String?  @db.Text
  mediaUrl   String?  @db.Text // Ruta local (ej. public/uploads/whatsapp/...)
  mimeType   String?
  status     String   @default("SENT") // SENT, DELIVERED, READ, FAILED
  timestamp  DateTime @default(now())
  contact    WhatsAppContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([timestamp])
}

